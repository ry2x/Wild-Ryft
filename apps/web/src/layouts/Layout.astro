---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

import { getI18n, getLanguageTag } from '../lib/i18n';

interface Props {
  title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;
const { locale, t } = await getI18n(Astro.cookies.get('locale')?.value);
---

<!doctype html>
<html lang={getLanguageTag(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Wild Ryft</title>
    <!-- Favicon / Meta -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={t('layout.metaDescription')} />
    <ClientRouter />
  </head>
  <body>
    <div class="app-container">
      <div class="bg-glow"></div>
      
      <!-- Top Header -->
      <header class="app-header glass">
        <a href="/" style="text-decoration: none;">
          <div class="logo-text">WILD STATS</div>
        </a>
        <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">
          Patch 5.1c • LIVE
        </div>
      </header>

      <!-- Sidebar (Desktop) or Bottom Nav (Mobile) -->
      <nav class="bottom-nav">
        <!-- Overview -->
        <a href="/" class={`bottom-nav-item ${pathname === '/' ? 'active' : ''}`}>
          <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          <span>{t('layout.overview')}</span>
        </a>

        <!-- Explore -->
        <a href="/explore" class={`bottom-nav-item ${pathname.startsWith('/explore') ? 'active' : ''}`}>
          <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <span>{t('layout.explore')}</span>
        </a>

        <!-- Meta Tiers -->
        <a href="/tiers" class={`bottom-nav-item ${pathname.startsWith('/tiers') ? 'active' : ''}`}>
          <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="8" y1="6" x2="21" y2="6"></line>
            <line x1="8" y1="12" x2="21" y2="12"></line>
            <line x1="8" y1="18" x2="21" y2="18"></line>
            <line x1="3" y1="6" x2="3.01" y2="6"></line>
            <line x1="3" y1="12" x2="3.01" y2="12"></line>
            <line x1="3" y1="18" x2="3.01" y2="18"></line>
          </svg>
          <span>{t('layout.tiers')}</span>
        </a>

        <!-- Analytics -->
        <a href="/analytics" class={`bottom-nav-item ${pathname.startsWith('/analytics') ? 'active' : ''}`}>
          <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 3v18h18"></path>
            <path d="m19 9-5 5-4-4-3 3"></path>
          </svg>
          <span>{t('layout.analytics')}</span>
        </a>

        <!-- Profile -->
        <a href="/profile" class={`bottom-nav-item ${pathname.startsWith('/profile') ? 'active' : ''}`}>
          <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
          <span>{t('layout.profile')}</span>
        </a>
      </nav>

      <!-- Main Slots Content -->
      <main class="main-content">
        <slot />
      </main>
    </div>
  </body>
</html>
